healthy_cells <- row.names(peng_2019_PDAC_sample@meta.data[peng_2019_PDAC_sample@meta.data$published_annotation == 'Ductal cell type 1' & peng_2019_PDAC_sample@meta.data$tissue == 'h',])
cancer_cells <- row.names(peng_2019_PDAC_sample@meta.data[peng_2019_PDAC_sample@meta.data$published_annotation == 'Ductal cell type 2',])
foldchange_computation_res <- foldchange_computation(peng_2019_PDAC_sample, healthy_cells, cancer_cells, sample_col='orig.ident', topNGenes=15000)
#here we remove the sample T5 since it contains a low number of cancer cells and fastCNV seems to require more cells
cells_to_keep <- row.names(peng_2019_PDAC_sample@meta.data[peng_2019_PDAC_sample@meta.data$orig.ident != 'T5',])
peng_2019_PDAC_sample_filtered <- subset(peng_2019_PDAC_sample, cells = cells_to_keep)
# healthy cells from healthy tissu ('h') are selected to avoid selecting missannotated cancer cells
healthy_cells <- row.names(peng_2019_PDAC_sample_filtered@meta.data[peng_2019_PDAC_sample_filtered@meta.data$published_annotation == 'Ductal cell type 1' & peng_2019_PDAC_sample_filtered@meta.data$tissue == 'h',])
cancer_cells <- row.names(peng_2019_PDAC_sample_filtered@meta.data[peng_2019_PDAC_sample_filtered@meta.data$published_annotation == 'Ductal cell type 2',])
foldchange_computation_res <- foldchange_computation(peng_2019_PDAC_sample_filtered, healthy_cells, cancer_cells, sample_col='orig.ident', topNGenes=15000)
table(peng_2019_PDAC_sample@meta.data$orig.ident)
