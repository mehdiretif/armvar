sapply(palettes, function(pac){if(selected_palette %in% palettes[[pac]]){print(pacf)}})
sapply(palettes, function(pac){if(selected_palette %in% palettes[[pac]]){print(pac)}})
palettes
sapply(palettes, function(pac){
print(pac)
